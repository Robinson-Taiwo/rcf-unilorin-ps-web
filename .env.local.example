# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (Project URL and the "anon public" key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for inviting admins (Supabase → Project Settings → API → service_role).
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
